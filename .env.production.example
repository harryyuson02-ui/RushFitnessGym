APP_NAME="Rush Fitness Gym"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://app.example.com
APP_TIMEZONE=Asia/Manila

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rush_fitness_gym
DB_USERNAME=rush_fitness_app
DB_PASSWORD=replace-with-a-strong-password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database

# Use local only on a server with a persistent disk and external backups.
# Use s3 on ephemeral/container hosting.
FILESYSTEM_DISK=s3
FILESYSTEM_THROW=true
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Gmail SMTP: use the full Gmail address and a Google App Password, not the normal account password.
# Google two-step verification must be enabled before creating an App Password.
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-gmail-address@gmail.com
MAIL_PASSWORD=replace-with-a-google-app-password
MAIL_FROM_ADDRESS=your-gmail-address@gmail.com
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
